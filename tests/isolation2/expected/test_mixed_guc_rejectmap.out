INSERT 0 100000
1: DROP SCHEMA mixed_s CASCADE;
DROP SCHEMA
1q: ... <quitting>

-- === object-independent quotas must never plant keyed entries in ===
-- === segment rejectmaps: those are indexed by relfilenode        ===
!\retcode gpconfig -c "diskquota.hard_limit" -v "on" > /dev/null;
-- start_ignore

-- end_ignore
