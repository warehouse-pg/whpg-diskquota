INSERT INTO cdqschema.cdq_t2 VALUES (3, 'x');
DROP DATABASE cdq_blind;
-- === reaper: a dropped database's usage must leave the total ===
-- monitor a database, fill it past the cap, then DROP DATABASE
-- without DROP EXTENSION first: the launcher must release the dead
-- database's bookkeeping so it stops counting toward the cluster cap
CREATE DATABASE cdq_phantom;
\c cdq_phantom
CREATE EXTENSION diskquota;
CREATE TABLE phantom_t (i INT, t TEXT) DISTRIBUTED BY (i);
INSERT INTO phantom_t SELECT g, repeat('x', 1000) FROM generate_series(1, 15000) g;
SELECT diskquota.wait_for_worker_new_epoch();
 wait_for_worker_new_epoch 
---------------------------
 t
(1 row)

\c contrib_regression
SET search_path TO cdqschema;
-- the phantom load counts while its database exists
SELECT total_size_in_bytes > 10 * 1048576 AS phantom_counted
FROM diskquota.show_cluster_quota_view;
 phantom_counted 
-----------------
 t
(1 row)

-- expect fail: over the cap
INSERT INTO cdqschema.cdq_t2 VALUES (4, 'x');
ERROR:  cluster's disk space quota exceeded
HINT:  cluster usage 16 MB exceeds cluster quota 10 MB; free disk space or raise diskquota.set_cluster_quota()
-- drop the database directly; retry while its worker's transient
-- connections block the drop (prints DROPPED once it goes through)
\! for i in $(seq 1 30); do psql -d contrib_regression -Atc "DROP DATABASE cdq_phantom" >/dev/null 2>&1 && { echo DROPPED; break; }; sleep 1; done
DROPPED
-- bounded wait for the launcher to reap the dead slot
DO $$ BEGIN FOR i IN 1..600 LOOP EXIT WHEN diskquota.cluster_total_size() < 10 * 1048576; PERFORM pg_sleep(0.1); END LOOP; END $$;
SELECT total_size_in_bytes < 10 * 1048576 AS phantom_reaped
FROM diskquota.show_cluster_quota_view;
 phantom_reaped 
----------------
 t
(1 row)

-- one worker cycle to clear the stale rejectmap entry; writes resume
SELECT diskquota.wait_for_worker_new_epoch();
 wait_for_worker_new_epoch 
---------------------------
 t
(1 row)

INSERT INTO cdqschema.cdq_t2 VALUES (5, 'x');
-- === reaper: a stale bookkeeping row must not break rotation ===
-- a database_list row that never got a dbArray slot was never counted
-- in num_db; reaping it must not decrement the count, or dynamic
-- rotation switches off while more databases than workers still need
-- a worker, freezing one database's bookkeeping
CREATE DATABASE cdq_rot;
\c cdq_rot
CREATE EXTENSION diskquota;
SELECT diskquota.wait_for_worker_new_epoch();
 wait_for_worker_new_epoch 
---------------------------
 t
(1 row)

\c contrib_regression
SET search_path TO cdqschema;
-- plant a bookkeeping row for a database oid that cannot exist
\c diskquota
INSERT INTO diskquota_namespace.database_list VALUES (987654321);
\c contrib_regression
SET search_path TO cdqschema;
-- bounded wait: the reaper removes the stale row
\! for i in $(seq 1 60); do n=$(psql -d diskquota -Atc "select count(*) from diskquota_namespace.database_list where dbid = 987654321"); [ "$n" = "0" ] && { echo REAPED; break; }; sleep 1; done
REAPED
-- with two monitored databases and diskquota.max_workers = 1, dynamic
-- rotation must keep serving both: both epochs keep advancing
\! A1=$(psql -d cdq_rot -Atc "select diskquota.show_worker_epoch()"); B1=$(psql -d contrib_regression -Atc "select diskquota.show_worker_epoch()"); sleep 10; A2=$(psql -d cdq_rot -Atc "select diskquota.show_worker_epoch()"); B2=$(psql -d contrib_regression -Atc "select diskquota.show_worker_epoch()"); { [ "$A1" != "$A2" ] && [ "$B1" != "$B2" ]; } && echo BOTH-ADVANCING || echo ROTATION-STUCK
BOTH-ADVANCING
\c cdq_rot
DROP EXTENSION diskquota;
\c contrib_regression
SET search_path TO cdqschema;
\! for i in $(seq 1 30); do psql -d contrib_regression -Atc "DROP DATABASE cdq_rot" >/dev/null 2>&1 && { echo DROPPED; break; }; sleep 1; done
DROPPED
-- === setter input validation ===
-- expect fail: the limit would overflow the internal byte computation
SELECT diskquota.set_database_quota(current_database()::text, '10000000000000 MB');
ERROR:  database quota limit larger than 2147483647 MB is not supported
-- expect fail: same cap on the cluster quota
SELECT diskquota.set_cluster_quota('10000000000000 MB');
ERROR:  cluster quota limit larger than 2147483647 MB is not supported
-- expect fail: set_cluster_quota persists outside the caller's
-- transaction, so it refuses to run inside an explicit block
BEGIN;
SELECT diskquota.set_cluster_quota('100 MB');
ERROR:  diskquota.set_cluster_quota() cannot run inside a transaction block
ROLLBACK;
-- a rolled-back database-quota set must never reach enforcement: the
-- worker is the only publisher of limits to shared memory
BEGIN;
SELECT diskquota.set_database_quota(current_database()::text, '1 MB');
 set_database_quota 
--------------------
 
(1 row)

ROLLBACK;
SELECT diskquota.wait_for_worker_new_epoch();
 wait_for_worker_new_epoch 
---------------------------
 t
(1 row)

SELECT diskquota.database_quota_limit_mb();
 database_quota_limit_mb 
-------------------------
                       0
(1 row)

-- === a stale quota_config row (e.g. restored from a dump) is inert ===
-- set_database_quota manages the row keyed by this database's oid; a
-- restored row still carries the dump-time oid and must be neither
-- enforced nor resurrected
-- load a few MB so the 1 MB cap below is genuinely exceeded
INSERT INTO cdqschema.cdq_t2 SELECT g, repeat('x', 1000) FROM generate_series(1, 3000) g;
SELECT diskquota.set_database_quota(current_database()::text, '1 MB');
